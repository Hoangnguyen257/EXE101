datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

// ---------------------------------------------------------------------------
// 1. ORGANIZATIONS, DEPARTMENTS, POSITIONS & USERS
// ---------------------------------------------------------------------------

model Organization {
  id        String   @id @default(cuid())
  name      String
  taxCode   String   @unique
  address   String
  plan      String   @default("Business")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  departments  Department[]
  positions    Position[]
  users        User[]
  customers    Customer[]
  shipments    Shipment[]
  documents    Document[]
  tags         Tag[]
  archiveBoxes ArchiveBox[]
  auditLogs    AuditLog[]
  syncEvents   SyncEvent[]
  pendingUploads PendingUpload[]
}

model Department {
  id          String   @id @default(cuid())
  orgId       String
  name        String
  code        String
  headUserId  String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userLinks    UserDepartment[]
  permissions  DepartmentPermission[]
  shipments    Shipment[]
  documents    Document[]
  shares       DocumentAccessPermission[]

  @@unique([orgId, code])
}

model Position {
  id          String   @id @default(cuid())
  orgId       String
  name        String
  level       Int      @default(1)
  description String?
  createdAt   DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userLinks    UserPosition[]

  @@unique([orgId, name])
}

model User {
  id                String    @id @default(cuid())
  orgId             String
  email             String    @unique
  passwordHash      String
  name              String
  initials          String
  roleCode          String    @default("STAFF") // ADMIN, MANAGER, STAFF
  isActive          Boolean   @default(true)
  mustChangePassword Boolean  @default(false)
  failedAttempts    Int       @default(0)
  lockedUntil       DateTime?
  twoFactorSecret   String?
  lastActiveAt      DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organization     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  role             Role         @relation(fields: [roleCode], references: [code])
  departments      UserDepartment[]
  positions        UserPosition[]
  permissions      UserPermission[]
  sessions         Session[]
  loginHistories   LoginHistory[]
  resetTokens      PasswordResetToken[]
  ownedShipments   Shipment[]
  createdDocuments Document[]    @relation("DocCreator")
  updatedDocuments Document[]    @relation("DocUpdater")
  auditLogs        AuditLog[]
  notifications    Notification[]
  sharesGranted    DocumentAccessPermission[] @relation("GrantedByUser")
  sharesReceived   DocumentAccessPermission[] @relation("TargetUser")
  shipmentParts    ShipmentParticipant[]
  statusChanges    ShipmentStatusHistory[]
  createdVersions  DocumentVersion[]
  createdShares    DocumentShare[]
  createdBoxes     ArchiveBox[]
}

model UserDepartment {
  id           String   @id @default(cuid())
  userId       String
  departmentId String
  isPrimary    Boolean  @default(false)
  isManager    Boolean  @default(false)
  joinedAt     DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([userId, departmentId])
}

model UserPosition {
  id         String   @id @default(cuid())
  userId     String
  positionId String
  assignedAt DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  position Position @relation(fields: [positionId], references: [id], onDelete: Cascade)

  @@unique([userId, positionId])
}

// ---------------------------------------------------------------------------
// 2. ENTERPRISE PERMISSIONS & ROLES
// ---------------------------------------------------------------------------

model Role {
  id          String   @id @default(cuid())
  code        String   @unique // ADMIN, MANAGER, STAFF
  name        String
  description String?

  users           User[]
  rolePermissions RolePermission[]
}

model Permission {
  id          String   @id @default(cuid())
  code        String   @unique // e.g. DOCUMENTS:VIEW, SHIPMENTS:EDIT
  module      String   // DOCUMENTS, SHIPMENTS, USERS, DEPARTMENTS, AUDIT, SETTINGS, ARCHIVE
  action      String   // VIEW, CREATE, EDIT, DELETE, UPLOAD, DOWNLOAD, SHARE, APPROVE, EXPORT, ASSIGN, RESTORE, MANAGE
  description String?

  rolePermissions RolePermission[]
  userPermissions UserPermission[]
  deptPermissions DepartmentPermission[]
}

model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model UserPermission {
  id           String  @id @default(cuid())
  userId       String
  permissionId String
  isGranted    Boolean @default(true) // true = Grant, false = Explicit Deny
  scope        String  @default("DEPARTMENT") // GLOBAL, ORGANIZATION, DEPARTMENT, ASSIGNED, SHARED, OWNED

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
}

model DepartmentPermission {
  id           String @id @default(cuid())
  departmentId String
  permissionId String
  scope        String @default("DEPARTMENT")

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([departmentId, permissionId])
}

model Session {
  id           String    @id @default(cuid())
  userId       String
  tokenHash    String    @unique
  ipAddress    String?
  userAgent    String?
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LoginHistory {
  id          String   @id @default(cuid())
  userId      String
  ipAddress   String?
  device      String?
  status      String   // SUCCESS, FAILED_BAD_PASSWORD, LOCKED, 2FA_FAILED
  attemptedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// 3. SHIPMENTS & CUSTOMERS
// ---------------------------------------------------------------------------

model Customer {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  shortName String
  taxCode   String
  email     String?
  phone     String?
  createdAt DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  shipments    Shipment[]
  documents    Document[]
  archiveBoxes ArchiveBox[]
}

model Shipment {
  id           String   @id @default(cuid())
  orgId        String
  jobNo        String   @unique
  blNo         String?
  customerId   String?
  departmentId String?
  mode         String   @default("sea") // sea, air, road
  origin       String?
  destination  String?
  etd          String?
  eta          String?
  status       String   @default("draft") // draft, booking, in_transit, arrived, on_yard, customs, delivered, closed
  draftStep    Int      @default(1)
  extra        Json?
  ownerId      String
  goodsDesc    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  organization  Organization             @relation(fields: [orgId], references: [id], onDelete: Cascade)
  customer      Customer?                @relation(fields: [customerId], references: [id])
  owner         User                     @relation(fields: [ownerId], references: [id])
  department    Department?              @relation(fields: [departmentId], references: [id])
  documents     Document[]
  goods         ShipmentGoods[]
  participants  ShipmentParticipant[]
  histories     ShipmentStatusHistory[]
  requirements  ShipmentRequirement[]
  notifications Notification[]
  pendingUploads PendingUpload[]
}

model ShipmentGoods {
  id          String   @id @default(cuid())
  shipmentId  String
  description String
  hsCode      String
  orderIndex  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
}

model ShipmentParticipant {
  id             String   @id @default(cuid())
  shipmentId     String
  userId         String
  roleInShipment String   @default("STAFF")
  assignedAt     DateTime @default(now())

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([shipmentId, userId])
}

model ShipmentStatusHistory {
  id         String   @id @default(cuid())
  shipmentId String
  oldStatus  String
  newStatus  String
  changedBy  String
  changedAt  DateTime @default(now())
  note       String?

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [changedBy], references: [id])
}

model ShipmentRequirement {
  id          String   @id @default(cuid())
  shipmentId  String
  docType     String   // BL, INVOICE, PACKING_LIST, BOOKING, DELIVERY_ORDER, ARRIVAL_NOTICE, CUSTOMS, CO
  isMandatory Boolean  @default(true)
  status      String   @default("MISSING") // MISSING, UPLOADED, APPROVED
  updatedAt   DateTime @updatedAt

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@unique([shipmentId, docType])
}

// ---------------------------------------------------------------------------
// 4. DOCUMENTS, VERSIONS, OCR & SHARING
// ---------------------------------------------------------------------------

model Document {
  id             String    @id @default(cuid())
  orgId          String
  shipmentId     String
  customerId     String
  departmentId   String
  type           String    // BL, INVOICE, PACKING_LIST, etc.
  customTypeName String?
  title          String
  fileName       String
  fileSizeBytes  Int       @default(0)
  storageKey     String
  pages          Int       @default(1)
  docDate        String
  retentionUntil String?
  archiveBoxId   String?
  editedHtml     String?
  isLocked       Boolean   @default(false)
  lockedBy       String?
  lockedAt       DateTime?
  isDeleted      Boolean   @default(false)
  deletedAt      DateTime?
  createdBy      String
  updatedBy      String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization   Organization             @relation(fields: [orgId], references: [id], onDelete: Cascade)
  shipment       Shipment                 @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  customer       Customer                 @relation(fields: [customerId], references: [id])
  department     Department               @relation(fields: [departmentId], references: [id])
  creator        User                     @relation("DocCreator", fields: [createdBy], references: [id])
  updater        User                     @relation("DocUpdater", fields: [updatedBy], references: [id])
  archiveBox     ArchiveBox?              @relation(fields: [archiveBoxId], references: [id])
  versions       DocumentVersion[]
  ocrResults     DocumentOcrResult[]
  tags           DocumentTag[]
  shares         DocumentShare[]
  accessGrants   DocumentAccessPermission[]
  notifications  Notification[]
}

model DocumentVersion {
  id            String   @id @default(cuid())
  documentId    String
  versionNumber Int
  fileName      String
  storageKey    String
  sizeBytes     Int
  uploadedBy    String
  uploadedAt    DateTime @default(now())
  changeNote    String?

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  uploader User     @relation(fields: [uploadedBy], references: [id])

  ocrResults DocumentOcrResult[]

  @@unique([documentId, versionNumber])
}

model DocumentOcrResult {
  id              String   @id @default(cuid())
  documentId      String
  versionId       String?
  status          String   @default("COMPLETED") // PENDING, PROCESSING, COMPLETED, FAILED
  confidenceScore Float    @default(90.0)
  rawText         String
  structuredData  String?  // JSON string: { blNo, invoiceNo, containerNo, customer, portOfLoading, portOfDischarge }
  extractedAt     DateTime @default(now())

  document Document         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version  DocumentVersion? @relation(fields: [versionId], references: [id])
}

model Tag {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  color     String   @default("#3b82f6")
  createdAt DateTime @default(now())

  organization Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  documents    DocumentTag[]

  @@unique([orgId, name])
}

model DocumentTag {
  documentId String
  tagId      String

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([documentId, tagId])
}

model ArchiveBox {
  id         String   @id @default(cuid())
  orgId      String
  code       String   @unique
  warehouse  String
  shelf      String
  box        String
  customerId String?
  period     String
  createdBy  String
  createdAt  DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  customer     Customer?    @relation(fields: [customerId], references: [id])
  creator      User         @relation(fields: [createdBy], references: [id])
  documents    Document[]
}

model DocumentShare {
  id            String   @id @default(cuid())
  documentId    String
  token         String   @unique
  passwordHash  String?
  expiresAt     DateTime
  allowDownload Boolean  @default(true)
  maxViews      Int?
  viewCount     Int      @default(0)
  isRevoked     Boolean  @default(false)
  createdBy     String
  createdAt     DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  creator  User     @relation(fields: [createdBy], references: [id])
}

model DocumentAccessPermission {
  id              String    @id @default(cuid())
  documentId      String
  targetDeptId    String?
  targetUserId    String?
  permissionLevel String    @default("VIEW") // VIEW, DOWNLOAD, EDIT
  expiresAt       DateTime?
  grantedBy       String
  createdAt       DateTime  @default(now())

  document   Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [targetDeptId], references: [id], onDelete: Cascade)
  user       User?       @relation("TargetUser", fields: [targetUserId], references: [id], onDelete: Cascade)
  grantor    User        @relation("GrantedByUser", fields: [grantedBy], references: [id])
}

// ---------------------------------------------------------------------------
// 5. AUDIT LOGS, NOTIFICATIONS & REALTIME SYNC
// ---------------------------------------------------------------------------

model AuditLog {
  id           String   @id @default(cuid())
  orgId        String
  userId       String
  action       String   // view, download, edit, delete, upload, share, restore, login, logout, permission_change
  resourceType String   // document, shipment, user, department, permission
  resourceId   String
  ipAddress    String?
  device       String?
  status       String   @default("SUCCESS") // SUCCESS, DENIED, FAILED
  diffJson     String?  // JSON of changes { before, after }
  createdAt    DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id])
}

model Notification {
  id          String   @id @default(cuid())
  orgId       String
  userId      String
  kind        String   // missing, retention, system, assignment
  severity    String   @default("medium") // high, medium, low
  title       String
  description String
  shipmentId  String?
  documentId  String?
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  shipment Shipment? @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  document Document? @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

model StorageObject {
  id             String   @id @default(cuid())
  storageKey     String   @unique
  bucket         String   @default("tml-docs")
  mimeType       String
  sizeBytes      Int
  checksumSha256 String?
  isEncrypted    Boolean  @default(false)
  createdAt      DateTime @default(now())
}

model SyncEvent {
  id         String   @id @default(cuid())
  orgId      String
  eventType  String   // DOCUMENT_CREATED, DOCUMENT_UPDATED, SHIPMENT_UPDATED, PERMISSION_CHANGED
  entityType String   // document, shipment, permission, user
  entityId   String
  payload    String   // JSON string
  occurredAt DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

model PendingUpload {
  id             String    @id @default(cuid())
  orgId          String
  shipmentId     String
  storageKey     String    @unique
  fileName       String
  fileSizeBytes  Int
  mimeType       String
  docType        String
  customTypeName String?
  docDate        String?
  uploadedBy     String
  expiresAt      DateTime
  confirmedAt    DateTime?
  createdAt      DateTime  @default(now())

  organization   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  shipment       Shipment     @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

