# ==============================================================================
# TML LOGISTICS DOCUMENT MANAGEMENT SYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Database Connection (SQLite for local standalone, PostgreSQL for distributed production)
# SQLite: file:./dev.db
# PostgreSQL: postgresql://postgres:password@localhost:5432/tml_logistics?schema=public
DATABASE_URL="file:./dev.db"

# JWT and Authentication Security (Minimum 32 characters random secret)
JWT_SECRET="replace-with-a-secure-random-32-char-secret-key-for-jwt"
NEXTAUTH_SECRET="replace-with-a-secure-random-32-char-secret-key-for-session"

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Storage Configuration
# Driver: "local" (Stored in local vault folder) or "s3" (AWS S3 / MinIO)
STORAGE_DRIVER="local"
STORAGE_LOCAL_PATH="./storage_vault"

# S3 / MinIO Configuration (Optional if STORAGE_DRIVER=s3)
# S3_ENDPOINT="http://localhost:9000"
# S3_BUCKET="tml-vault"
# S3_ACCESS_KEY="minioadmin"
# S3_SECRET_KEY="minioadmin"
# S3_REGION="us-east-1"

