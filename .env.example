# ==============================================================================
# TML LOGISTICS DOCUMENT MANAGEMENT SYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Database Connection
# Cấu hình tự động chuyển đổi schema provider (scripts/ensure-db-provider.ts)
# Local SQLite: file:./dev.db
# Production PostgreSQL: postgresql://postgres:YOUR_PASSWORD@localhost:5432/tml_logistics?schema=public
DATABASE_URL="file:./dev.db"

# Tùy chọn chỉ định rõ provider ('sqlite' | 'postgresql'). Nếu không truyền, hệ thống tự động suy luận từ DATABASE_URL
# DB_PROVIDER="postgresql"

# JWT and Authentication Security (Bắt buộc tối thiểu 32 ký tự, không dùng secret mặc định)
JWT_SECRET="replace-with-a-secure-random-32-char-secret-key-for-jwt"
NEXTAUTH_SECRET="replace-with-a-secure-random-32-char-secret-key-for-session"

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# Storage Provider Configuration (Lưu trữ chứng từ bền vững)
# ------------------------------------------------------------------------------
# STORAGE_DRIVER: "local" (Dành cho Dev/VPS có ổ cứng) hoặc "s3" (Bắt buộc khi chạy Serverless / Vercel)
STORAGE_DRIVER="local"
STORAGE_LOCAL_PATH="./storage_vault"

# Cấu hình Object Storage (Áp dụng khi STORAGE_DRIVER="s3" - AWS S3, Cloudflare R2, MinIO)
S3_BUCKET="tml-storage-vault"
S3_REGION="us-east-1"
# S3_ENDPOINT="http://localhost:9000"              # Bỏ comment nếu dùng MinIO hoặc Cloudflare R2
# S3_ACCESS_KEY_ID="minioadmin"
# S3_SECRET_ACCESS_KEY="minioadmin"
# S3_FORCE_PATH_STYLE="true"                       # Đặt "true" khi dùng MinIO
